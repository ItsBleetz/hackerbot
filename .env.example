# Required HackerOne researcher credentials (identifier/value shown when the API token was created)
HACKERONE_USERNAME=your_api_token_identifier
HACKERONE_API_TOKEN=your_hackerone_api_token

# Required program notification webhook
DISCORD_PROGRAM_WEBHOOK=https://discord.com/api/webhooks/your_program_webhook

# Optional; enables report monitoring when configured
DISCORD_REPORT_WEBHOOK=https://discord.com/api/webhooks/your_report_webhook

# summary or detailed
HACKERBOT_REPORT_NOTIFICATION_MODE=summary

# true or false; false disables all report fetching and notifications
HACKERBOT_REPORTS_ENABLED=true

# false suppresses comments authored by this report's researcher
HACKERBOT_REPORT_NOTIFY_OWN_COMMENTS=false

# true requires DISCORD_REPORT_WEBHOOK to belong to a Forum or Media channel
HACKERBOT_REPORT_THREADS_ENABLED=false
